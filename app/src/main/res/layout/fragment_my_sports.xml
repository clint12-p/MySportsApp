<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Sports Fragment"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a sport to view details:"
            android:textColor="@color/gray_600"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_football"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Football"
            android:textSize="18sp"
            app:icon="@drawable/ic_football"
            app:iconPadding="12dp"
            android:backgroundTint="@color/purple_500"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_basketball"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Basketball"
            android:textSize="18sp"
            app:icon="@drawable/ic_basketball"
            app:iconPadding="12dp"
            android:backgroundTint="@color/purple_500"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tennis"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Tennis"
            android:textSize="18sp"
            app:icon="@drawable/ic_tennis"
            app:iconPadding="12dp"
            android:backgroundTint="@color/purple_500"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_baseball"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Baseball"
            android:textSize="18sp"
            app:icon="@drawable/ic_baseball"
            app:iconPadding="12dp"
            android:backgroundTint="@color/purple_500"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>