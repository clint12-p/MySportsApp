<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.mysportsapp.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.mysportsapp.AccountFragment"
        android:label="Account"
        tools:layout="@layout/fragment_account" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.mysportsapp.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/mySportsFragment"
        android:name="com.example.mysportsapp.MySportsFragment"
        android:label="My Sports"
        tools:layout="@layout/fragment_my_sports">
        <action
            android:id="@+id/action_mySportsFragment_to_footballFragment"
            app:destination="@id/footballFragment" />
        <action
            android:id="@+id/action_mySportsFragment_to_basketballFragment"
            app:destination="@id/basketballFragment" />
        <action
            android:id="@+id/action_mySportsFragment_to_tennisFragment"
            app:destination="@id/tennisFragment" />
        <action
            android:id="@+id/action_mySportsFragment_to_baseballFragment"
            app:destination="@id/baseballFragment" />
    </fragment>

    <fragment
        android:id="@+id/footballFragment"
        android:name="com.example.mysportsapp.FootballFragment"
        android:label="Football"
        tools:layout="@layout/fragment_football" />

    <fragment
        android:id="@+id/basketballFragment"
        android:name="com.example.mysportsapp.BasketballFragment"
        android:label="Basketball"
        tools:layout="@layout/fragment_basketball" />

    <fragment
        android:id="@+id/tennisFragment"
        android:name="com.example.mysportsapp.TennisFragment"
        android:label="Tennis"
        tools:layout="@layout/fragment_tennis" />

    <fragment
        android:id="@+id/baseballFragment"
        android:name="com.example.mysportsapp.BaseballFragment"
        android:label="Baseball"
        tools:layout="@layout/fragment_baseball" />

</navigation>